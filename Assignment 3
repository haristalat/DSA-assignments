Q6: QUEUE APPLICATION - EVALUATE POSTFIX EXPRESSION 


Algorithm Explanation:

Stack-based Logic for Postfix Evaluation:
1. Iterate through each character in the postfix expression
2. If character is a digit: push its integer value onto the stack
3. If character is an operator (+, -, *, /):
   - Pop two operands: operand2 (top), operand1 (second)
   - Apply operator: result = operand1 operator operand2
   - Push result back onto stack
4. After processing all characters, the top of stack is the result
5. Special case: If division by zero occurs, print error and return -1

Why Stacks Work for Postfix:
- Postfix ordering ensures operands are always available when operators are 
  encountered
- LIFO nature of stack naturally handles the correct operator precedence
- No need for parentheses or operator precedence rules

#include <iostream>
#include <stack>
#include <string>
#include <cctype>
using namespace std;

int evaluatePostfix(string expr) {
    stack<int> st;
    for (char c : expr) {
        if (isdigit(c)) st.push(c - '0');
        else if (c == '+' || c == '-' || c == '*' || c == '/') {
            if (st.size() < 2) {
                cout << "Invalid postfix expression!" << endl;
                return -1;
            }
            int operand2 = st.top(); st.pop();
            int operand1 = st.top(); st.pop();
            int result;
            if (c == '+') result = operand1 + operand2;
            else if (c == '-') result = operand1 - operand2;
            else if (c == '*') result = operand1 * operand2;
            else if (c == '/') {
                if (operand2 == 0) {
                    cout << "Error: Division by zero!" << endl;
                    return -1;
                }
                result = operand1 / operand2;
            }
            st.push(result);
        }
    }
    return st.top();
}

int main() {
    cout << "23+ = " << evaluatePostfix("23+") << endl;
    cout << "53*2+ = " << evaluatePostfix("53*2+") << endl;
    cout << "842-* = " << evaluatePostfix("842-*") << endl;
    cout << "32/0* (division by zero):" << endl;
    evaluatePostfix("32/0*");
    return 0;
}



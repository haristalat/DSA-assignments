Q3: STACK APPLICATION - BALANCED BRACKETS CHECKER 


Algorithm Explanation:

Stack-based Logic for Balanced Brackets:
1. Iterate through each character in the expression
2. If opening bracket ( [ { : push it onto the stack
3. If closing bracket ) ] } :
   - If stack is empty, return false (unmatched closing bracket)
   - Pop from stack and check if it matches
   - If types don't match, return false
4. After processing all characters, stack must be empty
5. Return true if balanced, false otherwise

This works because LIFO ensures every opening bracket finds its matching 
closing bracket in the correct nested order.


#include <iostream>
#include <stack>
#include <string>
using namespace std;

bool isBalanced(string expr) {
    stack<char> st;
    for (char c : expr) {
        if (c == '(' || c == '[' || c == '{') st.push(c);
        else if (c == ')' || c == ']' || c == '}') {
            if (st.empty()) return false;
            char top = st.top(); st.pop();
            if ((c == ')' && top != '(') ||
                (c == ']' && top != '[') ||
                (c == '}' && top != '{')) return false;
        }
    }
    return st.empty();
}

int main() {
    string test1 = "(a + [b * {c + d}])";
    string test2 = "{a + (b - [c]}";
    cout << "Test 1: " << (isBalanced(test1) ? "Balanced" : "Not Balanced") << endl;
    cout << "Test 2: " << (isBalanced(test2) ? "Balanced" : "Not Balanced") << endl;
    return 0;
}


